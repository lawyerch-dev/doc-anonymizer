# ---- Python ----
.venv/
venv/
# 字节码缓存: 正常路径都由 scripts/setup_dev.sh 重定向到 var/pycache(见 AGENTS.md);
# 这条兜住"用别的 python 跑"(系统 python / 别的 venv)的情况
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 下载/构建得到的资产(体积大, 不入库) ----
# var/ 是"可再生资产"的唯一入口: var/models(权重) / var/vendor(file-viewer 预览包)
# 壳的构建产物留在 apps/desktop/build/(Hutch 的 buildFolder 只接受项目相对路径, 不许 .. 跳出)
var/
*.gguf
*.onnx
*.safetensors

# ---- 运行产物(脱敏输出) ----
# 默认落在 var/out(上面那条已覆盖); out*/ 兜住显式 -o out 的历史习惯
out*/
*.log

# ---- 本地环境变量 ----
.env
.env.*

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store

node_modules/
.webout/

# 桌面壳(Electrobun/Hutch)的下载缓存与运行期临时目录
apps/desktop/.hutch/
apps/desktop/.cottontail-tmp/
apps/desktop/artifacts/
