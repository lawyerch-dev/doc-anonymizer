# ---- Python ----
.venv/
venv/
# 字节码缓存: 正常路径都由 scripts/setup_dev.sh 重定向到 var/pycache(见 AGENTS.md);
# 这条兜住"用别的 python 跑"(系统 python / 别的 venv)的情况
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# hypothesis 属性测试的示例数据库
.hypothesis/
# 散落在仓库根的 wheel(主路径 dist/ build/ 上面已挡, 这条兜底 uv build 的临时产物)
*.whl

# ---- 下载/构建得到的资产(体积大, 不入库) ----
# var/ 是"可再生资产"的唯一入口: var/models(权重) / var/vendor(file-viewer 预览包)
# 壳的构建产物留在 apps/desktop/build/(PyInstaller 侧车; 不进 src-tauri/target, 那是 cargo 的地盘)
var/
*.gguf
*.onnx
*.safetensors

# ---- 运行产物(脱敏输出) ----
# 默认落在 var/out(上面那条已覆盖); out*/ 兜住显式 -o out 的历史习惯
out*/
*.log

# ---- 本地环境变量 ----
.env
.env.*

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
*.swo
*~
# 合并冲突手工解决后的残留 / 手工备份与临时件
*.orig
*.bak
*.tmp
.DS_Store
# Windows(CI 双平台构建, 贡献者可能用 Windows)
Thumbs.db
Desktop.ini

# ---- 前端工作区(npm workspaces: packages/ui + website + apps/web + apps/desktop) ----
node_modules/
# TS 增量编译缓存
*.tsbuildinfo
# JS 测试覆盖率产物
coverage/
# 网站构建产物与生成的内容副本由 website/.gitignore 管(dist/ .astro/ src/content/docs/)

# ---- 宣传视频制作工作区(Remotion 工程, 本地生产用, 不入库) ----
# node_modules ~400MB + 渲染成片 out/ + 截图素材 assets/; 源工程只留在本地
video-promo/

# 桌面壳(Tauri)的构建产物: 壳自己的编译输出全在 src-tauri/target 下(与仓库根的 build/ 无关)
apps/desktop/src-tauri/target/
# Tauri 每次构建都会重写的能力/权限 schema, 是生成物不是源
apps/desktop/src-tauri/gen/schemas/
# 打包用的资源根暂存区: Tauri 只把**本项目内**的路径收进包, 所以 scripts/dev.sh dist
# 先把 configs/web/samples/vendor/sidecar 摆到这里, 再由 tauri.dist.conf.json 整体收进包内 docanon/
# (见 apps/desktop/README.md)
apps/desktop/stage/
# 安装包散落兜底(target/ build/ stage/ 是主路径, 已逐条登记; 这条防手动拷出的包)
*.dmg
*.exe
*.AppImage
*.blockmap

# ---- Playwright e2e(tests/e2e) 的跑测产物 ----
test-results/
playwright-report/
/blob-report/
/playwright/.cache/

# ---- agent 执行计划的临时工作区(ledger/简报/评审包, 不入库) ----
.superpowers/
.workbuddy/
